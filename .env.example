# Required. A key from a PAID Mistral workspace (console.mistral.ai), with
# Zero Data Retention requested. Keys expire: note the date when you create one.
MISTRAL_API_KEY=

# Optional (defaults shown)
# MISTRAL_MODEL=mistral-medium-latest
# MISTRAL_RECALL_PASS=true
# LIMIT_PER_IP_HOUR=15
# LIMIT_PER_IP_DAY=40
# DAILY_PAGE_BUDGET=3000
# CONCURRENCY=2
# MAX_QUEUE=12
